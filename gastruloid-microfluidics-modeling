        "\n",
        "def simulate_rotational_pde(D_rot=0.0, pipetting_kick=False, t_end=72.0, seed=0):\n",
        "    rng = np.random.default_rng(seed)\n",
        "    d_W, d_A = 0.045, 1.25\n",
        "    rho_W, mu_W = 0.26, 0.25\n",
        "    rho_A, mu_A = 0.36, 0.35\n",
        "    kappa = 0.14\n",
        "\n",
        "    dt_s = 0.04\n",
        "    t_grid = np.arange(0, t_end + dt_s, dt_s)\n",
        "    dphi = np.sqrt(2.0 * D_rot * dt_s) * rng.standard_normal(len(t_grid))\n",
        "    dphi[0] = 0.0\n",
        "    if pipetting_kick:\n",
        "        # Daily 200 uL manual medium exchange at t=24h scrambles free-floating orientation\n",
        "        idx_24 = np.argmin(np.abs(t_grid - 24.0))\n",
        "        dphi[idx_24] += rng.uniform(-np.pi, np.pi)\n",
        "    phi_t_arr = np.cumsum(dphi)\n",
        "\n",
        "    def rhs(t, y):\n",
        "        W = y[:N_TH]\n",
        "        A = np.maximum(y[N_TH:], 1e-4)\n",
        "        phi_now = np.interp(t, t_grid, phi_t_arr)\n",
        "\n",
        "        if t <= 22.0:\n",
        "            # Sensed CHIR around R=125 um surface centered at C_IDEAL (peaks at theta=pi facing Left channel)\n",
        "            c_surf = C_IDEAL * (1.0 - 0.32 * np.cos(theta - phi_now))\n",
        "            s_ext = 0.045 * (c_surf / C_IDEAL)\n",
        "        else:\n",
        "            s_ext = np.zeros_like(theta)\n",
        "\n",
        "        lap_W = (np.roll(W, -1) - 2*W + np.roll(W, 1)) / dtheta**2\n",
        "        lap_A = (np.roll(A, -1) - 2*A + np.roll(A, 1)) / dtheta**2\n",
        "        dW = d_W * lap_W + rho_W * (W**2 + s_ext) / (A * (1.0 + kappa * W**2)) - mu_W * W\n",
        "        dA = d_A * lap_A + rho_A * W**2 - mu_A * A\n",
        "        return np.concatenate([dW, dA])\n",
        "\n",
        "    y0 = np.concatenate([0.88 * (1 + 0.012 * rng.standard_normal(N_TH)),\n",
