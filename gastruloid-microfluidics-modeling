        "NX, NY = 42, 25\n",
        "dx, dy = LX / NX, LY / NY\n",
        "x_2d = (np.arange(NX) + 0.5) * dx\n",
        "y_2d = (np.arange(NY) + 0.5) * dy\n",
        "\n",
        "is_left_ch  = x_2d < 0.40\n",
        "is_left_peg = (x_2d >= 0.40) & (x_2d < 0.55)\n",
        "is_chamber  = (x_2d >= 0.55) & (x_2d <= 1.55)\n",
        "is_right_peg= (x_2d > 1.55) & (x_2d <= 1.70)\n",
        "is_right_ch = x_2d > 1.70\n",
        "\n",
        "D_x = np.where(is_left_peg | is_right_peg, 1.26, 1.80)  # mm^2/h\n",
        "\n",
        "def solve_2d_chip_steady(Q_side_uL_h=30.0, Q_hold_uL_h=0.0, cross_flow_uL_h=0.0):\n",
        "    # Note: 1 uL = 1 mm^3\n",
        "    v_side = Q_side_uL_h / (0.40 * H_CH)        # Axial velocity in flanking channels (mm/h)\n",
        "    v_hold = Q_hold_uL_h / (1.00 * H_CH)        # Axial holding velocity in central chamber (mm/h)\n",
        "    v_cross = cross_flow_uL_h / (LY * H_CH)     # Direct left-to-right cross-flow velocity (mm/h)\n",
        "\n",
        "    vy_prof = np.where(is_left_ch | is_right_ch, v_side, np.where(is_chamber, v_hold, 0.0))\n",
        "\n",
        "    N_dof = NY * NX\n",
        "    M = lil_matrix((N_dof, N_dof))\n",
        "    rhs_b = np.zeros(N_dof)\n",
        "\n",
        "    for j in range(NY):\n",
        "        for i in range(NX):\n",
        "            k = j * NX + i\n",
        "            # Inlet Dirichlet BCs at y = 0 for supply channels (and central holding inlet if active)\n",
        "            if j == 0 and is_left_ch[i]:\n",
        "                M[k, k] = 1.0\n",
        "                rhs_b[k] = C_LEFT_INLET\n",
        "                continue\n",
        "            if j == 0 and is_right_ch[i]:\n",
        "                M[k, k] = 1.0\n",
        "                rhs_b[k] = 0.0\n",
        "                continue\n",
        "            if j == 0 and is_chamber[i] and Q_hold_uL_h > 0:\n",
        "                # Central holding port pre-equilibrated at C_IDEAL (or basal media; here fresh N2B27 = 0 uM tests dilution!)\n",
        "                M[k, k] = 1.0\n",
        "                rhs_b[k] = 0.0\n",
        "                continue\n",
        "\n",
        "            diag = 0.0\n",
        "            # x-diffusion (harmonic face diffusivity) + optional left-to-right cross-advection\n",
        "            if i > 0:\n",
        "                D_w = 2 * D_x[i] * D_x[i-1] / (D_x[i] + D_x[i-1])\n",
        "                coeff_w = D_w / dx**2 + max(v_cross, 0.0) / dx\n",
        "                M[k, k - 1] -= coeff_w\n",
        "                diag += coeff_w\n",
        "            if i < NX - 1:\n",
        "                D_e = 2 * D_x[i] * D_x[i+1] / (D_x[i] + D_x[i+1])\n",
        "                coeff_e = D_e / dx**2\n",
        "                M[k, k + 1] -= coeff_e\n",
        "                diag += coeff_e + max(v_cross, 0.0) / dx if i > 0 else coeff_e\n",
        "\n",
        "            # y-diffusion + upwind axial advection (vy >= 0)\n",
        "            if j > 0:\n",
        "                coeff_s = D_x[i] / dy**2 + vy_prof[i] / dy\n",
        "                M[k, k - NX] -= coeff_s\n",
        "                diag += coeff_s\n",
        "            if j < NY - 1:\n",
        "                coeff_n = D_x[i] / dy**2\n",
        "                M[k, k + NX] -= coeff_n\n",
        "                diag += coeff_n\n",
        "\n",
        "            M[k, k] = diag\n",
        "\n",
        "    C_sol = spsolve(M.tocsr(), rhs_b).reshape((NY, NX))\n",
        "    return C_sol\n",
        "\n",
        "# 4a-1: Sweep Q_side to find minimum flow rate keeping gradient >= 95% uniform across entire chip\n",
        "Q_sweep = np.geomspace(0.2, 150.0, 30)\n",
        "grad_retention_side = []\n",
        "i_gL = np.argmin(np.abs(x_2d - (1.05 - 0.15)))  # Gastruloid left edge (x = 0.90 mm)\n",
        "i_gR = np.argmin(np.abs(x_2d - (1.05 + 0.15)))  # Gastruloid right edge (x = 1.20 mm)\n",
        "j_mid, j_out = NY // 2, NY - 2\n",
        "\n",
        "# Reference ideal clamped gradient at very high side flow (500 uL/h)\n",
        "C_ref = solve_2d_chip_steady(Q_side_uL_h=500.0)\n",
        "dC_ideal_clamped = C_ref[j_mid, i_gL] - C_ref[j_mid, i_gR]\n",
        "\n",
        "for q_val in Q_sweep:\n",
        "    C_q = solve_2d_chip_steady(Q_side_uL_h=q_val)\n",
        "    dC_outlet = C_q[j_out, i_gL] - C_q[j_out, i_gR]\n",
        "    grad_retention_side.append(dC_outlet / dC_ideal_clamped)\n",
        "\n",
        "grad_retention_side = np.array(grad_retention_side)\n",
        "Q_SIDE_MIN_95 = Q_sweep[np.where(grad_retention_side >= 0.95)[0][0]]\n",
        "\n",
        "# 4a-2: Transient time to reach steady-state equilibrium at Q_side = 30 uL/h\n",
        "Q_DESIGN = 30.0\n",
        "vy_design = np.where(is_left_ch | is_right_ch, Q_DESIGN / (0.40 * H_CH), 0.0)\n",
        "\n",
        "def rhs_transient_2d(t, c_flat):\n",
        "    C = c_flat.reshape((NY, NX)).copy()\n",
        "    C[0, is_left_ch] = C_LEFT_INLET\n",
        "    C[0, is_right_ch] = 0.0\n",
        "    dC = np.zeros_like(C)\n",
        "\n",
        "    # Vectorized interior x & y fluxes\n",
        "    D_face_x = 2 * D_x[:-1] * D_x[1:] / (D_x[:-1] + D_x[1:])\n",
        "    flux_x = D_face_x[None, :] * (C[:, :-1] - C[:, 1:]) / dx\n",
        "    dC[:, 0]    -= flux_x[:, 0] / dx\n",
        "    dC[:, 1:-1] += (flux_x[:, :-1] - flux_x[:, 1:]) / dx\n",
        "    dC[:, -1]   += flux_x[:, -1] / dx\n",
        "\n",
        "    flux_y_diff = D_x[None, :] * (C[:-1, :] - C[1:, :]) / dy\n",
        "    dC[0, :]    -= flux_y_diff[0, :] / dy\n",
        "    dC[1:-1, :] += (flux_y_diff[:-1, :] - flux_y_diff[1:, :]) / dy\n",
        "    dC[-1, :]   += flux_y_diff[-1, :] / dy\n",
        "\n",
        "    # Upwind axial advection\n",
        "    dC[1:, :] -= vy_design[None, :] * (C[1:, :] - C[:-1, :]) / dy\n",
        "    dC[0, is_left_ch | is_right_ch] = 0.0\n",
        "    return dC.ravel()\n",
        "\n",
        "c_init_2d = np.zeros(NY * NX)\n",
        "c_init_2d.reshape((NY, NX))[0, is_left_ch] = C_LEFT_INLET\n",
        "sol_2d_t = solve_ivp(rhs_transient_2d, [0, 2.5], c_init_2d, method=\"BDF\", t_eval=np.linspace(0, 2.5, 150))\n",
        "C_t_arr = sol_2d_t.y.reshape((NY, NX, -1))\n",
        "dC_t = C_t_arr[j_mid, i_gL, :] - C_t_arr[j_mid, i_gR, :]\n",
        "t_eq_95 = sol_2d_t.t[np.where(dC_t >= 0.95 * dC_t[-1])[0][0]]\n",
        "t_eq_99 = sol_2d_t.t[np.where(dC_t >= 0.99 * dC_t[-1])[0][0]]\n",
        "\n",
        "# 4b: Hydrodynamic Pillar-Pinning Mechanics vs. Gradient Dilution & Shear Stress\n",
        "Q_hold_sweep = np.geomspace(0.2, 60.0, 35)  # uL/h central axial holding flow\n",
        "rms_angle_deg, grad_keep_hold, shear_mPa = [], [], []\n",
        "grad_keep_cross = []\n",
        "\n",
        "for q_h in Q_hold_sweep:\n",
        "    # 1. Gradient retention under central holding flow vs. direct left-to-right cross-flow\n",
        "    C_hold = solve_2d_chip_steady(Q_side_uL_h=Q_DESIGN, Q_hold_uL_h=q_h)\n",
        "    grad_keep_hold.append((C_hold[j_mid, i_gL] - C_hold[j_mid, i_gR]) / dC_ideal_clamped)\n",
        "\n",
        "    C_cr = solve_2d_chip_steady(Q_side_uL_h=Q_DESIGN, cross_flow_uL_h=q_h)\n",
        "    grad_keep_cross.append((C_cr[j_mid, i_gL] - C_cr[j_mid, i_gR]) / dC_ideal_clamped)\n",
        "\n",
        "    # 2. Hydrodynamic seating force & restoring torque at 50 um PDMS pillar trap (SI units)\n",
        "    q_m3_s = q_h * 1e-9 / 3600.0\n",
        "    v_ch_m_s = q_m3_s / (1.0e-3 * 0.49e-3)\n",
        "    v_gap_m_s = q_m3_s / (10 * 50e-6 * 0.49e-3)  # Flow partitioned across ~10 pillar gaps (50 um wide)\n",
        "\n",
        "    # Stokes chamber drag + local suction pressure drop across occluded 50 um pillar seat\n",
        "    F_stokes = 6.0 * np.pi * ETA_MEDIA * R_GAST_M * v_ch_m_s\n",
        "    dP_gap = (12.0 * ETA_MEDIA * 60e-6 / (50e-6)**2) * v_gap_m_s\n",
        "    F_seat = F_stokes + dP_gap * (50e-6 * 160e-6)\n",
        "\n",
        "    # Pinning torque (two-post geometric wedge arm a=25 um + soft contact friction) vs active cell torque (~2.2 pN*um)\n",
        "    tau_pin_pNum = F_seat * (25.0 + 0.15 * 125.0) * 1e12  # pN * um\n",
        "    tau_active_noise = 2.2                                # pN * um active migration/convection fluctuation\n",
        "    sigma_deg = 95.0 / (1.0 + (tau_pin_pNum / tau_active_noise)**1.5)\n",
        "    rms_angle_deg.append(sigma_deg)\n",
        "\n",
        "    # Peak surface wall shear stress (mPa) with confinement factor beta = 2.4\n",
        "    tau_wall_mPa = 2.4 * (1.5 * ETA_MEDIA * max(v_ch_m_s, 0.35 * v_gap_m_s) / R_GAST_M) * 1e3\n",
        "    shear_mPa.append(tau_wall_mPa)\n",
        "\n",
        "rms_angle_deg  = np.array(rms_angle_deg)\n",
        "grad_keep_hold = np.array(grad_keep_hold)\n",
        "shear_mPa      = np.array(shear_mPa)\n",
        "\n",
        "valid_idx = np.where((rms_angle_deg <= 5.0) & (grad_keep_hold >= 0.80) & (shear_mPa <= 10.0))[0]\n",
        "q_pin_min, q_pin_max = Q_hold_sweep[valid_idx[0]], Q_hold_sweep[valid_idx[-1]]\n",
        "\n",
        "print(f\"[4a] Minimum flanking flow for >=95% constant gradient: Q_side >= {Q_SIDE_MIN_95:.1f} uL/h\")\n",
        "print(f\"[4a] Time to reach steady gradient at Q_side = {Q_DESIGN:.0f} uL/h: \"\n",
        "      f\"t_95 = {t_eq_95*60:.1f} min ({t_eq_95:.2f} h), t_99 = {t_eq_99*60:.1f} min ({t_eq_99:.2f} h)\")\n",
        "print(f\"[4b] Optimal central pillar-pinning flow window: Q_hold = {q_pin_min:.1f} to {q_pin_max:.1f} uL/h \"\n",
        "      f\"(locks rotation <5 deg, retains >80% CHIR gradient, shear < {shear_mPa[valid_idx[-1]]:.2f} mPa)\")\n",
        "\n",
        "fig, axes = plt.subplots(2, 2, figsize=(13, 9.5))\n",
        "\n",
        "# Panel A: Steady 2D Concentration Map at Q_side = 30 uL/h + Q_hold = 3 uL/h\n",
        "C_opt_2d = solve_2d_chip_steady(Q_side_uL_h=Q_DESIGN, Q_hold_uL_h=3.0)\n",
        "im0 = axes[0, 0].imshow(C_opt_2d, origin=\"lower\", aspect=\"auto\",\n",
        "                        extent=[0, LX, 0, LY], cmap=\"viridis\")\n",
        "for xb in [0.40, 0.55, 1.55, 1.70]:\n",
        "    axes[0, 0].axvline(xb, color=\"white\", ls=\"--\", lw=1.0)\n",
        "axes[0, 0].add_patch(plt.Circle((1.05, 0.75), 0.125, fill=False, ec=\"cyan\", lw=2.0))\n",
        "axes[0, 0].set_xlabel(\"x Across Chip (mm) [Left Ch | PEG | Chamber | PEG | Right Ch]\")\n",
        "axes[0, 0].set_ylabel(\"y Flow Axis (mm)\")\n",
        "axes[0, 0].set_title(\"A. Clamped 2D CHIR Field (Q_side=30, Q_hold=3 µL/h)\")\n",
        "plt.colorbar(im0, ax=axes[0, 0], label=\"CHIR99021 (µM)\")\n",
        "\n",
        "# Panel B: Q_side Sweep & Equilibration Time\n",
        "axes[0, 1].plot(Q_sweep, 100 * grad_retention_side, lw=2.2, color=\"#1f77b4\", label=\"Outlet Gradient Retention (%)\")\n",
        "axes[0, 1].axhline(95, color=\"gray\", ls=\":\", label=\"95% Uniformity Threshold\")\n",
        "axes[0, 1].axvline(Q_SIDE_MIN_95, color=\"#d62728\", ls=\"--\", label=f\"Min Q_side = {Q_SIDE_MIN_95:.1f} µL/h\")\n",
        "axes[0, 1].set_xscale(\"log\")\n",
        "axes[0, 1].set_xlabel(\"Flanking Channel Flow Rate Q_side (µL/h, log scale)\")\n",
        "axes[0, 1].set_ylabel(\"Downstream Gradient Retention (%)\")\n",
        "axes[0, 1].set_title(\"B. Flanking Perfusion Required for Constant Gradient\")\n",
        "axes[0, 1].legend(fontsize=8)\n",
        "\n",
        "# Panel C: Transient Startup Curve to Equilibrium\n",
        "axes[1, 0].plot(sol_2d_t.t * 60, dC_t, lw=2.3, color=\"#2ca02c\")\n",
        "axes[1, 0].axvline(t_eq_95 * 60, color=\"#ff7f0e\", ls=\"--\", label=f\"95% Eq: {t_eq_95*60:.0f} min\")\n",
        "axes[1, 0].axvline(t_eq_99 * 60, color=\"#9467bd\", ls=\":\", label=f\"99% Eq: {t_eq_99*60:.0f} min\")\n",
        "axes[1, 0].set_xlabel(\"Perfusion Time (minutes)\")\n",
        "axes[1, 0].set_ylabel(\"ΔC Across Gastruloid (µM)\")\n",
        "axes[1, 0].set_title(f\"C. Equilibration Startup Dynamics (Q_side = {Q_DESIGN:.0f} µL/h)\")\n",
        "axes[1, 0].legend(fontsize=8)\n",
        "\n",
        "# Panel D: Hydrodynamic Pinning Window (Q_hold) vs. Cross-Flow Failure\n",
        "ax_d2 = axes[1, 1].twinx()\n",
        "l1 = axes[1, 1].plot(Q_hold_sweep, 100 * grad_keep_hold, lw=2.2, color=\"#1f77b4\", label=\"Gradient % (Central Hold Flow)\")\n",
        "l2 = axes[1, 1].plot(Q_hold_sweep, 100 * np.array(grad_keep_cross), \"--\", lw=1.8, color=\"#7f7f7f\", label=\"Gradient % (Direct Cross-Flow)\")\n",
        "l3 = ax_d2.plot(Q_hold_sweep, rms_angle_deg, lw=2.2, color=\"#d62728\", label=\"Angular Wobble σ_θ (deg)\")\n",
        "axes[1, 1].axvspan(q_pin_min, q_pin_max, color=\"#2ca02c\", alpha=0.18, label=f\"Optimal Pinning ({q_pin_min:.1f}–{q_pin_max:.1f} µL/h)\")\n",
        "axes[1, 1].set_xscale(\"log\")\n",
        "axes[1, 1].set_xlabel(\"Holding / Cross-Flow Rate (µL/h, log scale)\")\n",
        "axes[1, 1].set_ylabel(\"Gastruloid Gradient Retention (%)\", color=\"#1f77b4\")\n",
        "ax_d2.set_ylabel(\"Angular Fluctuation σ_θ (deg)\", color=\"#d62728\")\n",
        "axes[1, 1].set_title(\"D. Hydrodynamic Pillar-Pinning Operating Window\")\n",
        "lines_d = l1 + l2 + l3\n",
        "axes[1, 1].legend(lines_d, [l.get_label() for l in lines_d] + [f\"Optimal ({q_pin_min:.1f}–{q_pin_max:.1f} µL/h)\"],\n",
        "                  loc=\"center left\", fontsize=7.3)\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.savefig(\"fig4_flow_and_pinning_design.png\", dpi=200)\n",
        "plt.show()\n",
        "files.download(\"fig4_flow_and_pinning_design.png\")"
