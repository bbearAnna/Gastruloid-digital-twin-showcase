        "      f\"(24h RMS angle = {np.degrees(np.sqrt(2*D_ROT_ACTIVE*24)):.1f} deg)\")\n",
        "\n",
        "# Periodic Turing Activator-Inhibitor PDE on Gastruloid Perimeter (N = 64 angular nodes)\n",
        "N_TH = 64\n",
        "theta = np.linspace(0, 2 * np.pi, N_TH, endpoint=False)\n",
