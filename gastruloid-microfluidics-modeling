        "# --- Cell 3: Calibration to Experimental 96-Well Data, Out-of-Sample Validation & Sensitivity ---\n",
        "from scipy.optimize import least_squares\n",
        "\n",
        "# Time in hours after CHIR addition at 48h AA -> corresponds to [96h, 120h, 144h] AA\n",
        "t_obs = np.array([48.0, 72.0, 96.0])\n",
        "\n",
        "# Experimental mean axial lengths (um) from EPFL LSCB Report Figs. 3b & 4b (150 uL 96-well, n=6)\n",
        "exp_data = {\n",
        "    \"TLC\": [\n",
        "        (\"0.2x (24h)\", 0.474, 24.0, np.array([260.0, 350.0, 660.0])),\n",
        "        (\"1.0x (18h)\", 2.370, 18.0, np.array([370.0, 640.0, 940.0])),\n",
        "        (\"1.0x (24h)\", 2.370, 24.0, np.array([315.0, 540.0, 675.0])),\n",
        "        (\"1.0x (48h)\", 2.370, 48.0, np.array([320.0, 600.0, 530.0])),\n",
        "        (\"5.0x (24h)\", 11.85, 24.0, np.array([260.0, 270.0, 320.0])),\n",
        "    ],\n",
        "    \"SBr\": [\n",
        "        (\"0.2x (24h)\", 0.474, 24.0, np.array([320.0, 490.0, 890.0])),\n",
        "        (\"1.0x (18h)\", 2.370, 18.0, np.array([360.0, 740.0, 1000.0])),\n",
        "        (\"1.0x (24h)\", 2.370, 24.0, np.array([365.0, 650.0, 855.0])),\n",
        "        (\"1.0x (48h)\", 2.370, 48.0, np.array([360.0, 770.0, 660.0])),\n",
        "        (\"5.0x (24h)\", 11.85, 24.0, np.array([350.0, 440.0, 530.0])),\n",
        "    ]\n",
        "}\n",
        "\n",
        "# Held-out validation data from Report Fig. 5b: partial 50 uL exchange after 1x 24h pulse\n",
        "val_partial_50uL = {\n",
        "    \"TLC\": np.array([280.0, 500.0, 605.0]),\n",
        "    \"SBr\": np.array([360.0, 590.0, 770.0]),\n",
        "}\n",
        "\n",
        "def chir_protocol(t, chir_uM, pulse_h, clearance_per_wash=1.0):\n",
        "    if t <= pulse_h:\n",
        "        return chir_uM\n",
        "    if clearance_per_wash >= 0.99:\n",
        "        return 0.0\n",
        "    n_washes = int((t - pulse_h) // 24.0) + 1\n",
        "    return chir_uM * ((1.0 - clearance_per_wash) ** n_washes)\n",
        "\n",
        "def simulate_calibrated_ode(params, chir_uM, pulse_h, t_eval, L0=260.0, clearance_per_wash=1.0):\n",
        "    # 4 structurally identifiable parameters:\n",
        "    # k_pol    : Wnt AP polarization rate [1/(uM*h)]\n",
        "    # k_stress : Normalized Wnt over-saturation stress rate [1/(uM*h)] (S=1 = critical fatigue threshold)\n",
        "    # v_ext    : Maximal post-gastrulation axial extension rate [um/h]\n",
        "    # k_ret    : Late tissue compaction/retraction rate under excess Wnt stress [1/h]\n",
        "    k_pol, k_stress, v_ext, k_ret = params\n",
        "\n",
        "    def rhs(t, y):\n",
        "        P, M, S, L = y\n",
        "        c = chir_protocol(t, chir_uM, pulse_h, clearance_per_wash)\n",
        "        dP = k_pol * c * (1.0 - P)\n",
        "        dM = 0.055 * (P - M)\n",
        "        dS = k_stress * c * (1.0 + 0.12 * c)\n",
        "\n",
        "        gate_ext  = 1.0 / (1.0 + np.exp(-(t - 44.0) / 5.0))\n",
        "        gate_late = 1.0 / (1.0 + np.exp(-(t - 70.0) / 4.0))\n",
        "        acute_blk = 1.0 / (1.0 + (S / 2.2) ** 3)\n",
        "\n",
        "        dL = gate_ext * v_ext * M * acute_blk / (1.0 + gate_late * S**4) \\\n",
        "             - gate_late * k_ret * (S**3) * max(L - L0, 0.0)\n",
        "        return [dP, dM, dS, dL]\n",
        "\n",
        "    sol = solve_ivp(rhs, [0.0, 96.0], [0.0, 0.0, 0.0, L0], t_eval=t_eval, method=\"RK45\", max_step=1.0)\n",
        "    return sol.y[3]\n",
        "\n",
        "p0 = [0.07, 0.015, 16.0, 0.05]\n",
        "lb = [0.005, 0.001, 4.0, 0.001]\n",
        "ub = [0.500, 0.100, 50.0, 0.500]\n",
