        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from scipy import ndimage\n",
        "from scipy.sparse import csr_matrix\n",
        "from scipy.sparse.csgraph import shortest_path\n",
        "from scipy.integrate import solve_ivp\n",
        "from skimage import filters, morphology, measure\n",
        "from scipy.sparse import lil_matrix\n",
        "from scipy.sparse.linalg import spsolve\n",
        "from google.colab import files\n",
        "\n",
        "np.random.seed(42)\n",
        "plt.rcParams.update({'font.size': 9.5, 'figure.dpi': 130})\n",
        "\n",
        "PX_UM = 4.0  # Spatial calibration: 4.0 um per pixel (320 px = 1280 um FOV)\n",
        "\n",
        "def generate_cell_line_phantom(line=\"TLC\", condition=\"optimal_144h\", seed=0, size=320):\n",
        "    rng = np.random.default_rng(seed)\n",
        "    yy, xx = np.mgrid[0:size, 0:size]\n",
        "    s = np.linspace(0, 1, 90)\n",
        "\n",
        "    if condition == \"chip_static_144h\" and line == \"SBr\":\n",
        "        # Fig. 6b: SBr in static Chip No. 3 at 0.5x-0.7x stays large & nearly spherical\n",
        "        L_um = 430.0 + rng.normal(0, 18)\n",
        "        cx = size/2 + (L_um / PX_UM) * 0.12 * (s - 0.5)\n",
        "        cy = np.full_like(s, size/2)\n",
        "        r_um = 195.0 - 15.0 * s\n",
        "        reporter_prof = 0.35 + 0.20 * s\n",
        "    elif line == \"TLC\":\n",
        "        # TLC (TCF/LEF::mCherry): slender, uniform trunk narrowing + C-shaped bending\n",
        "        L_um = 720.0 + rng.normal(0, 30)\n",
        "        bend_amp = (26.0 + rng.normal(0, 4))\n",
        "        chord_px = (L_um / PX_UM) * 0.84\n",
        "        cx = (size - chord_px)/2 + chord_px * s\n",
        "        cy = size/2 + bend_amp * np.sin(np.pi * s)\n",
        "        r_um = (152.0 + rng.normal(0, 6)) - 34.0 * s + 8.0 * np.sin(np.pi * s)\n",
        "        reporter_prof = np.exp(-((1.0 - s) / 0.42)**2)\n",
        "    elif line == \"SBr\":\n",
        "        # SBr (T/Bra::mCherry): wide bulbous anterior head + constricted neck + narrow tail\n",
        "        L_um = 890.0 + rng.normal(0, 35)\n",
        "        chord_px = (L_um / PX_UM) * 0.94\n",
        "        cx = (size - chord_px)/2 + chord_px * s\n",
        "        cy = size/2 + (9.0 + rng.normal(0, 3)) * np.sin(np.pi * s)\n",
        "        # Sigmoidal transition from wide head bulb (R~260 um) to narrow tail (R~102 um)\n",
        "        bulb = 1.0 / (1.0 + np.exp((s - 0.36) / 0.06))\n",
        "        r_um = (102.0 + rng.normal(0, 5)) + (158.0 + rng.normal(0, 8)) * bulb\n",
        "        reporter_prof = np.exp(-((1.0 - s) / 0.28)**2)\n",
        "\n",
        "    mask = np.zeros((size, size), dtype=bool)\n",
        "    fluo = np.zeros((size, size), dtype=float)\n",
        "    for x0, y0, r0_um, rep in zip(cx, cy, r_um, reporter_prof):\n",
        "        r_px = max(r0_um / PX_UM, 3.0)\n",
        "        disk = (xx - x0)**2 + (yy - y0)**2 <= r_px**2\n",
        "        mask |= disk\n",
        "        fluo[disk] = np.maximum(fluo[disk], rep)\n",
        "\n",
        "    bf = np.where(mask, 0.26, 0.86) + 0.045 * rng.standard_normal((size, size))\n",
        "    fluo_img = ndimage.gaussian_filter(fluo * mask, sigma=2.5)\n",
        "    fluo_img = np.clip(fluo_img + 0.025 * rng.standard_normal((size, size)), 0, 1)\n",
        "    return np.clip(bf, 0, 1), fluo_img\n",
        "\n",
        "def analyze_gastruloid_morphology(bf, fluo_img):\n",
        "    smooth = filters.gaussian(bf, sigma=2.0)\n",
        "    mask = ndimage.binary_fill_holes(smooth < filters.threshold_otsu(smooth))\n",
        "    lbl = measure.label(mask)\n",
        "    largest = max(measure.regionprops(lbl), key=lambda r: r.area).label\n",
        "    mask = (lbl == largest)\n",
        "\n",
        "    edt_um = ndimage.distance_transform_edt(mask) * PX_UM\n",
        "    skel = morphology.skeletonize(mask)\n",
        "    coords = np.argwhere(skel)\n",
        "\n",
        "    if len(coords) <= 2:\n",
        "        path = coords\n",
        "        geod_um = 0.0\n",
        "    else:\n",
        "        diff = coords[:, None, :] - coords[None, :, :]\n",
        "        dmat = np.hypot(diff[..., 0], diff[..., 1]) * PX_UM\n",
        "        adj = csr_matrix(np.where((dmat > 0) & (dmat <= 1.6 * PX_UM), dmat, 0.0))\n",
        "        dist_m, preds = shortest_path(adj, directed=False, return_predecessors=True)\n",
        "        finite_d = np.where(np.isfinite(dist_m), dist_m, -1.0)\n",
        "        i_s, i_e = np.unravel_index(np.argmax(finite_d), finite_d.shape)\n",
        "        geod_um = finite_d[i_s, i_e]\n",
        "        idx_list = [i_e]\n",
        "        cur = i_e\n",
        "        while cur != i_s and cur >= 0:\n",
        "            cur = preds[i_s, cur]\n",
        "            if cur >= 0:\n",
        "                idx_list.append(cur)\n",
        "        path = coords[idx_list[::-1]]\n",
        "\n",
        "    # Orient Anterior (s=0, low reporter) -> Posterior (s=1, high reporter)\n",
        "    rep_s = fluo_img[path[:, 0], path[:, 1]]\n",
        "    if len(rep_s) > 4 and rep_s[:len(rep_s)//3].mean() > rep_s[-len(rep_s)//3:].mean():\n",
        "        path = path[::-1]\n",
        "        rep_s = rep_s[::-1]\n",
        "\n",
        "    r_prof_um = edt_um[path[:, 0], path[:, 1]]\n",
        "    d_prof_um = 2.0 * r_prof_um\n",
        "    L_axial_um = d_prof_um[0] if len(r_prof_um) == 1 else (geod_um + r_prof_um[0] + r_prof_um[-1])\n",
        "    D_max_um = np.max(d_prof_um)\n",
        "    D_mean_um = np.mean(d_prof_um)\n",
        "\n",
        "    # Multi-parametric morphological descriptors\n",
        "    EI_classical = L_axial_um / D_max_um\n",
        "    EI_mean_width = L_axial_um / D_mean_um\n",
        "\n",
        "    n_pts = len(d_prof_um)\n",
        "    d_ant = np.mean(d_prof_um[:max(1, n_pts // 3)])\n",
        "    d_post = np.mean(d_prof_um[-max(1, n_pts // 3):])\n",
        "    ap_tapering = (d_ant - d_post) / (d_ant + d_post)\n",
        "    tail_fraction = np.mean(d_prof_um < 0.65 * D_max_um)\n",
        "\n",
        "    chord_um = np.hypot(path[-1, 0] - path[0, 0], path[-1, 1] - path[0, 1]) * PX_UM + r_prof_um[0] + r_prof_um[-1]\n",
        "    tortuosity = L_axial_um / max(chord_um, 1e-3)\n",
        "\n",
        "    # Non-overlapping inscribed circles for visualization\n",
        "    circles = []\n",
        "    for idx in np.argsort(-r_prof_um):\n",
        "        yc, xc = path[idx]\n",
        "        rc_px = r_prof_um[idx] / PX_UM\n",
        "        if all(np.hypot(xc - x0, yc - y0) >= (rc_px + r0 - 1.5) for x0, y0, r0 in circles):\n",
        "            circles.append((xc, yc, rc_px))\n",
        "\n",
        "    return {\n",
        "        \"mask\": mask, \"path\": path, \"circles\": circles, \"d_prof_um\": d_prof_um,\n",
        "        \"L_um\": L_axial_um, \"EI_classical\": EI_classical, \"EI_mean\": EI_mean_width,\n",
        "        \"tapering\": ap_tapering, \"tail_frac\": tail_fraction, \"tortuosity\": tortuosity\n",
        "    }\n",
        "\n",
        "# Evaluate ensembles (n=12 replicates per group)\n",
        "groups = [\n",
        "    (\"TLC (96-Well 1x, 144h)\", \"TLC\", \"optimal_144h\"),\n",
        "    (\"SBr (96-Well 1x, 144h)\", \"SBr\", \"optimal_144h\"),\n",
        "    (\"SBr (Static Chip 0.5x, 144h)\", \"SBr\", \"chip_static_144h\"),\n",
        "]\n",
        "ensemble_stats = {}\n",
        "rep_examples = {}\n",
        "\n",
        "print(f\"{'Condition':<30} | {'Length (um)':<12} | {'Classical EI':<12} | {'Mean-Width EI':<13} | {'AP Taper':<9} | {'Tail Frac'}\")\n",
        "print(\"-\" * 96)\n",
        "for label, line, cond in groups:\n",
        "    metrics = [analyze_gastruloid_morphology(*generate_cell_line_phantom(line, cond, seed=100+k)) for k in range(12)]\n",
        "    ensemble_stats[label] = metrics\n",
        "    rep_examples[label] = (generate_cell_line_phantom(line, cond, seed=101)[0], metrics[1])\n",
        "    print(f\"{label:<30} | {np.mean([m['L_um'] for m in metrics]):>6.1f} ± {np.std([m['L_um'] for m in metrics]):<4.1f} | \"\n",
        "          f\"{np.mean([m['EI_classical'] for m in metrics]):>5.2f} ± {np.std([m['EI_classical'] for m in metrics]):<4.2f} | \"\n",
        "          f\"{np.mean([m['EI_mean'] for m in metrics]):>6.2f} ± {np.std([m['EI_mean'] for m in metrics]):<4.2f} | \"\n",
        "          f\"{np.mean([m['tapering'] for m in metrics]):>8.2f} | {np.mean([m['tail_frac'] for m in metrics]):>7.2f}\")\n",
        "\n",
        "# Plot 4-panel comparison\n",
        "fig, axes = plt.subplots(2, 2, figsize=(12.5, 9.5))\n",
        "\n",
        "for ax, label in zip([axes[0, 0], axes[0, 1]], [\"TLC (96-Well 1x, 144h)\", \"SBr (96-Well 1x, 144h)\"]):\n",
        "    bf_img, m = rep_examples[label]\n",
        "    ax.imshow(bf_img, cmap=\"gray\")\n",
        "    ax.contour(m[\"mask\"], colors=\"#ff4b4b\", linewidths=1.2)\n",
        "    ax.plot(m[\"path\"][:, 1], m[\"path\"][:, 0], color=\"cyan\", lw=2.2, label=\"Geodesic Spine\")\n",
        "    for xc, yc, rc in m[\"circles\"]:\n",
        "        ax.add_patch(plt.Circle((xc, yc), rc, fill=False, ec=\"gold\", lw=1.2))\n",
        "    ax.set_title(f\"{label}\\nL={m['L_um']:.0f} µm | Classical EI={m['EI_classical']:.2f} | Mean-Width EI={m['EI_mean']:.2f}\")\n",
        "    ax.axis(\"off\")\n",
        "\n",
        "# Panel C: Width profile D(s) along normalized AP axis\n",
        "colors_g = [\"#1f77b4\", \"#d62728\", \"#7f7f7f\"]\n",
        "for (label, _, _), col in zip(groups, colors_g):\n",
        "    _, m = rep_examples[label]\n",
        "    s_ax = np.linspace(0, 1, len(m[\"d_prof_um\"]))\n",
        "    axes[1, 0].plot(s_ax, m[\"d_prof_um\"], lw=2.3, color=col, label=label)\n",
        "axes[1, 0].set_xlabel(\"Normalized AP Centerline s (0 = Anterior, 1 = Posterior)\")\n",
        "axes[1, 0].set_ylabel(\"Local Inscribed Diameter D(s) [µm]\")\n",
        "axes[1, 0].set_title(\"C. AP Width Profiles Reveal SBr Head-Bulb vs. TLC Slender Trunk\")\n",
        "axes[1, 0].legend(fontsize=8)\n",
        "\n",
        "# Panel D: Classical EI vs. Mean-Width EI & Tapering Fingerprint\n",
        "x_idx = np.arange(len(groups))\n",
        "w = 0.26\n",
        "ei_c = [np.mean([m[\"EI_classical\"] for m in ensemble_stats[g[0]]]) for g in groups]\n",
        "ei_m = [np.mean([m[\"EI_mean\"] for m in ensemble_stats[g[0]]]) for g in groups]\n",
        "tap_scaled = [1.0 + 3.0 * np.mean([m[\"tapering\"] for m in ensemble_stats[g[0]]]) for g in groups]\n",
        "\n",
        "axes[1, 1].bar(x_idx - w, ei_c, width=w, label=\"Classical EI (L / D_max)\", color=\"#8ecae6\")\n",
        "axes[1, 1].bar(x_idx, ei_m, width=w, label=\"Mean-Width EI (L / D_mean)\", color=\"#219ebc\")\n",
        "axes[1, 1].bar(x_idx + w, tap_scaled, width=w, label=\"Club Asymmetry (1 + 3*T_AP)\", color=\"#ffb703\")\n",
        "axes[1, 1].set_xticks(x_idx)\n",
        "axes[1, 1].set_xticklabels([\"TLC\\n(96w 1x)\", \"SBr\\n(96w 1x)\", \"SBr\\n(Chip 0.5x)\"])\n",
        "axes[1, 1].set_ylabel(\"Dimensionless Metric Value\")\n",
        "axes[1, 1].set_title(\"D. Resolving the SBr Paradox With Multi-Parametric Metrics\")\n",
        "axes[1, 1].legend(fontsize=8)\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.savefig(\"fig1_sbr_vs_tlc_morphology.png\", dpi=200)\n",
        "plt.show()\n",
        "files.download(\"fig1_sbr_vs_tlc_morphology.png\")"
